# Radio Browser self-hosted mirror (optional)
# Run: docker run -d -p 8080:8080 --name radiobrowser ghcr.io/segler-alex/radiobrowser-api-rust
# Then set your public mirror URL here (https://...). Vercel will use it on next build.
NEXT_PUBLIC_RADIO_SELF_HOST=

# Example:
# NEXT_PUBLIC_RADIO_SELF_HOST=https://radio-mirror.yourdomain.com
